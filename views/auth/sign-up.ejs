<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Sign Up — IncidentWatch</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body class="auth-body">
  <main class="auth-page" id="signup-page">
    <div class="auth-card" id="signup-card">

      <div class="auth-brand">
        <span class="auth-brand-mark"></span>
        <span class="auth-brand-name">IncidentWatch</span>
      </div>

      <h1 class="auth-title">Create an account</h1>
      <p class="auth-subtitle">Sign up to start tracking records</p>

      <form action="/sign-up" method="POST" class="auth-form" id="signup-form">

        <div class="form-group" id="name-group">
          <label for="name" class="form-label">Name</label>
          <input type="text" id="name" name="name" class="form-input" required>
        </div>

        <div class="form-group" id="email-group">
          <label for="email" class="form-label">Email</label>
          <input type="email" id="email" name="email" class="form-input" required>
        </div>

        <div class="form-group" id="password-group">
          <label for="password" class="form-label">Password</label>
          <input type="password" id="password" name="password" class="form-input" required minlength="8">
        </div>

        <button type="submit" class="btn btn-primary" id="signup-submit">Sign Up</button>
      </form>

      <p class="auth-footer">
        Already have an account?
        <a href="/sign-in" class="auth-link">Sign in</a>
      </p>

    </div>
  </main>
</body>
</html>
