<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Sign In — IncidentWatch</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body class="auth-body">
  <main class="auth-page" id="signin-page">
    <div class="auth-card" id="signin-card">

      <div class="auth-brand">
        <span class="auth-brand-mark"></span>
        <span class="auth-brand-name">IncidentWatch</span>
      </div>

      <h1 class="auth-title">Sign in</h1>
      <p class="auth-subtitle">Sign in to continue to your dashboard</p>

      <form action="/sign-in" method="POST" class="auth-form" id="signin-form">

        <div class="form-group" id="email-group">
          <label for="email" class="form-label">Email</label>
          <input type="email" id="email" name="email" class="form-input" required>
        </div>

        <div class="form-group" id="password-group">
          <label for="password" class="form-label">Password</label>
          <input type="password" id="password" name="password" class="form-input" required>
        </div>

        <button type="submit" class="btn btn-primary" id="signin-submit">Sign In</button>
      </form>

      <p class="auth-footer">
        Don't have an account?
        <a href="/sign-up" class="auth-link">Sign up</a>
      </p>

    </div>
  </main>
</body>
</html>
